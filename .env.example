# ============================================================
# ChronoGen — Environment Configuration Template
# Copy this file: cp .env.example .env
# Then fill in your actual values in .env
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=3000

# ── Database ─────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=your_mysql_password_here
DB_NAME=chronogen

# Set to true if connecting to a cloud MySQL provider (TiDB, Aiven, PlanetScale, Railway, etc.)
DB_SSL=false
